table Medidas
	lineageTag: 2fa741ef-7cb6-4cc5-ae31-5aea89ce08af

	measure Total_Inscritos = COUNT('Base Principal'[ID Candidato])
		formatString: 0
		lineageTag: 1e84da19-3c9b-41df-a8e6-63fad198365a

	measure Total_Dinamica = CALCULATE(COUNT('Base Principal'[ID Candidato]), 'Base Principal'[Etapa] IN {"Aprovados em Dinâmica", "Reprovados em Dinâmica"})
		formatString: 0
		lineageTag: 9ffa0ccf-caf5-4b51-bdc9-1eb4c8f72de8

	measure Total_Painel = CALCULATE(COUNT('Base Principal'[ID Candidato]), 'Base Principal'[Etapa] IN {"Aprovados em Painel", "Reprovados em Painel"})
		formatString: 0
		lineageTag: 9ebacec6-2c79-4df4-9828-8e32fc6351d1

	measure Total_Fora_Perfil = ```
			CALCULATE(COUNT('Base Principal'[ID Candidato]), 'Base Principal'[Etapa] = "Fora do Perfil")
			
			```
		formatString: 0
		lineageTag: 89c9706a-4166-44f9-8082-ad59693f9b22

	measure Total_Aprovados_Programa = ```
			
			COALESCE(
			    CALCULATE(
			        COUNT('Controle de Posições'[ID Candidato Aprovado]),
			        'Controle de Posições'[Status da Posição] = "PREENCHIDA"
			    ), 
			    0
			)
			```
		formatString: 0
		lineageTag: b4aeea3b-0f54-46b1-980a-99572737c95e

	measure Total_Reprovados_etapas = CALCULATE(COUNT('Base Principal'[ID Candidato]), 'Base Principal'[Etapa] IN {"Reprovados em Dinâmica", "Reprovados em Painel"})
		formatString: 0
		lineageTag: f3100702-b569-44e7-90ea-8033947c5ec9

	measure Percentual_Reprovados_etapas = DIVIDE([Total_Reprovados_etapas], [Total_Inscritos], 0)
		lineageTag: 05b8d629-7c47-4290-bfc8-1e2da434f040

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_Reprovados_Programa =
			
			VAR Aprovados = DISTINCT('Controle de Posições'[ID Candidato Aprovado])
			RETURN
			CALCULATE(
			    COUNT('Base Principal'[ID Candidato]),
			    'Base Principal'[Etapa] IN {"Aprovados em Dinâmica", "Reprovados em Dinâmica", "Aprovados em Painel", "Reprovados em Painel"},
			    NOT('Base Principal'[ID Candidato] IN Aprovados)
			)
		formatString: 0
		lineageTag: db1e6777-9e64-4b10-b66a-8eeaa13222fb

	measure Quantidade_Por_Etapa =
			
			SWITCH(
			    SELECTEDVALUE(Tabela_Etapas[Etapa]),
			    "Inscritos", [Total_Inscritos],
			    "Dinâmica de Grupo", [Total_Dinamica],
			    "Painel com Gestores", [Total_Painel],
			    "Aprovados no Programa", [Total_Aprovados_Programa],
			    BLANK()
			)
		formatString: 0
		lineageTag: 6e0a8807-a885-46df-bf9b-0f5cb3866905

