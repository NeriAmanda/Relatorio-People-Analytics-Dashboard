	partition Top_10_Inscritos_Tabela = calculated
		mode: import
		source = ```
				
				TOPN(
				    10, 
				    SUMMARIZE(
				        'Base Principal', 
				        'Base Principal'[Curso], 
				        'Base Principal'[Instituição de Ensino], 
				        "Total_Inscritos", CALCULATE(COUNT('Base Principal'[ID Candidato]))
				    ), 
				    [Total_Inscritos], 
				    DESC
				)
				```

